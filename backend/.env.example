# Exemplo de configurações para ambiente local/DEV.
# Copie este ficheiro para .env e substitua os valores conforme necessário.

# Obrigatório para as validações assistidas por IA
GEMINI_API_KEY="a-sua-chave-aqui"

# URL da base de dados local SQLite (default) ou PostgreSQL
DATABASE_URL="sqlite+pysqlite:///:memory:"
