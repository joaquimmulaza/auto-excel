# Copie para backend/.env ? nunca commite secrets reais.

ENVIRONMENT=local
AUTH_MODE=local

# SQLite local (default) ou PostgreSQL/Supabase (staging/producao)
DATABASE_URL=sqlite+pysqlite:////tmp/cotarco-ccm.db
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Local JWT (AUTH_MODE=local apenas)
AUTH_SECRET=cotarco-dev-secret-change-me

# Supabase (producao / AUTH_MODE=supabase)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT: cotarco-ccm usa ES256 via JWKS em
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET e opcional (apenas tokens legacy HS256)
# SUPABASE_JWT_SECRET=

# Storage: local | supabase
STORAGE_BACKEND=local
STORAGE_BUCKET=job-files
COTARCO_STORAGE_DIR=/tmp/cotarco-storage

# CORS allowlist (sem wildcard em producao)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini (backend only)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
