# Copie para backend/.env ? nunca commite secrets reais.

# APP_ENV tem preced?ncia sobre ENVIRONMENT (local|test|production)
APP_ENV=local
ENVIRONMENT=local
AUTH_MODE=local

# SQLite local (default) ou PostgreSQL/Supabase (staging/produ??o)
DATABASE_URL=sqlite+pysqlite:////tmp/cotarco-ccm.db
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Local JWT (AUTH_MODE=local apenas)
AUTH_SECRET=cotarco-dev-secret-change-me

# Supabase (produ??o / AUTH_MODE=supabase / STORAGE_BACKEND=supabase)
# SUPABASE_SERVICE_ROLE_KEY: APENAS no backend ? nunca no frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=

# Storage: local | supabase
# Em APP_ENV=production, o default ? supabase se STORAGE_BACKEND n?o estiver definido.
STORAGE_BACKEND=local
STORAGE_BUCKET=job-files
COTARCO_STORAGE_DIR=/tmp/cotarco-storage

# CORS allowlist (sem wildcard em produ??o)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gemini (backend only) ? default gemini-3.5-flash-lite
# Override opcional: gemini-3.6-flash | gemini-3.8-flash
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
