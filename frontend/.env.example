# Local development (default if unset): http://localhost:8000/api/v1
# On Vercel with Services (repo-root vercel.json): leave unset → same-origin /api/v1
# NEXT_PUBLIC_API_URL=https://your-api.example.com/api/v1

# Optional Next.js rewrite proxy (frontend-only project root):
# BACKEND_URL=https://your-fastapi-host
